    {
      "id": "pregunta-1",
      "type": "exercise",
      "chapter": "Práctica",
      "title": "E1 · Identifica una variable",
      "notes": "Da 2 minutos; revela la explicación después de que contesten.",
      "exercise": {
        "id": "ex-variable",
        "type": "single",
        "prompt": "Para estudiar cómo afecta la luz al crecimiento de las plantas, ¿qué variable manipulamos?",
        "options": [
          {
            "value": "a",
            "label": "La altura final de la planta"
          },
          {
            "value": "b",
            "label": "Las horas de luz recibidas"
          },
          {
            "value": "c",
            "label": "El color de la maceta"
          }
        ],
        "answer": "b",
        "explanation": "Las horas de luz son la variable independiente; el crecimiento es la variable dependiente.",
        "minutes": 2
      }
    },
    {
      "id": "pregunta-2",
      "type": "exercise",
      "chapter": "Práctica",
      "title": "E2 · Selecciona todas las válidas",
      "exercise": {
        "id": "ex-control",
        "type": "multiple",
        "prompt": "¿Qué factores conviene mantener constantes si solo estudias el efecto de la luz?",
        "options": [
          {
            "value": "a",
            "label": "Cantidad de agua"
          },
          {
            "value": "b",
            "label": "Tipo de tierra"
          },
          {
            "value": "c",
            "label": "Horas de luz"
          }
        ],
        "answer": [
          "a",
          "b"
        ],
        "explanation": "Para aislar el efecto de la luz, mantén agua y tierra en condiciones comparables.",
        "minutes": 2
      }
    },
    {
      "id": "pregunta-3",
      "type": "exercise",
      "chapter": "Práctica",
      "title": "E3 · Concepto clave",
      "exercise": {
        "id": "ex-hipotesis",
        "type": "text",
        "prompt": "¿Cómo se llama una explicación provisional que podemos contrastar?",
        "answer": [
          "hipótesis",
          "una hipótesis"
        ],
        "explanation": "Hipótesis: proposición contrastable, no conclusión confirmada.",
        "minutes": 1
      }
    },
    {
      "id": "pregunta-4",
